# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here

# GitHub Repository Configuration
# The repository where bulletins and artifacts will be stored
VITE_GITHUB_REPO_OWNER=your_github_username_or_org
VITE_GITHUB_REPO_NAME=architecture-bulletin-data

# Optional: GitHub API Base URL (defaults to https://api.github.com)
# VITE_GITHUB_API_URL=https://api.github.com

# Application Configuration
VITE_APP_TITLE=Architecture Bulletin
VITE_APP_DESCRIPTION=Team Deliverables Bulletin Board

# Environment
NODE_ENV=development
