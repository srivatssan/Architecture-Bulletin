# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here

# OAuth Proxy URL (required for token exchange)
# Use a serverless function or backend proxy to securely exchange authorization code
# Example: https://your-domain.netlify.app/.netlify/functions/github-oauth
VITE_OAUTH_PROXY_URL=https://your-oauth-proxy-url-here

# GitHub Repository Configuration
# The repository where bulletins and artifacts will be stored
VITE_GITHUB_REPO_OWNER=your_github_username_or_org
VITE_GITHUB_DATA_REPO=architecture-bulletin-data
VITE_GITHUB_BRANCH=main

# GitHub Redirect URI (defaults to current origin + /callback)
# VITE_GITHUB_REDIRECT_URI=http://localhost:5173/callback

# Application Configuration
VITE_APP_TITLE=Architecture Bulletin
VITE_APP_DESCRIPTION=Team Deliverables Bulletin Board

# Environment
NODE_ENV=development
